# Postgres — matches docker-compose.yml (bun run db:up)
DATABASE_URL=postgres://animenew:animenew@localhost:5432/animenew

# Better Auth: generate a secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shikimori API
SHIKIMORI_URL=https://shikimori.one
# Shikimori asks every client to identify itself with the application name.
SHIKIMORI_USER_AGENT=animenew
# 1 = offline demo data instead of the real API (for working without network access)
SHIKIMORI_MOCK=0

# Optional social sign-in (leave empty to hide the buttons)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
